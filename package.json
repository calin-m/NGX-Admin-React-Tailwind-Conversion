{
  "name": "ngx-admin-react-tailwind-conversion",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "start": "node scripts/start-all.js",
    "dev:all": "node scripts/start-all.js",
    "build": "vite build",
    "preview": "vite preview",
    "test": "vitest",
    "test:ui": "vitest --ui --open",
    "test:coverage": "vitest run --coverage",
    "test:run": "vitest run --reporter=default --reporter=json --outputFile=test-results.json",
    "test:watch": "vitest watch --reporter=default --reporter=json --outputFile=test-results.json",
    "lint": "eslint src",
    "copy-assets": "node scripts/copy-public-assets.js",
    "verify": "node scripts/verify-build.js",
    "docs:sync": "node scripts/generate-architecture-matrix.js && node scripts/generate-legacy-docs.js && node scripts/generate-changelog.js",
    "docs:legacy": "node scripts/generate-legacy-docs.js",
    "adr:new": "node scripts/new-adr.js",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build",
    "prepare": "husky"
  },
  "dependencies": {
    "lucide-react": "^0.460.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@babel/parser": "^7.26.8",
    "@eslint/js": "^9.19.0",
    "@storybook/react-vite": "^8.6.0",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.2.0",
    "@vitejs/plugin-react": "^4.3.4",
    "@vitest/coverage-v8": "^3.0.5",
    "@vitest/ui": "^3.0.5",
    "concurrently": "^9.1.2",
    "eslint": "^9.19.0",
    "eslint-plugin-react-hooks": "^5.1.0",
    "eslint-plugin-react-refresh": "^0.4.18",
    "husky": "^9.1.7",
    "jsdom": "^26.0.0",
    "storybook": "^8.6.0",
    "vite": "^6.0.11",
    "vitest": "^3.0.5"
  }
}
