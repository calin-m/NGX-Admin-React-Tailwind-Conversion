{
  "compilerOptions": {
    "target": "ESNext",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "react-jsx",
    "allowJs": true,
    "checkJs": false,
    "baseUrl": "."
  },
  "include": [
    "src/**/*",
    "scripts/**/*",
    "vite.config.js",
    "vitest.config.js",
    "eslint.config.js"
  ],
  "exclude": [
    "node_modules",
    "dist",
    "storybook-static",
    "coverage",
    "old-src"
  ]
}
